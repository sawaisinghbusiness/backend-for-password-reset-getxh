# Application Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security / HMAC Salt Secret for OTP Hashing
# IMPORTANT: Generate a strong random secret key in production
OTP_SECRET_SALT=getxh_secure_otp_salt_change_this_in_production_key_32chars

# Firebase Admin SDK Credentials
# Option 1: File path to Firebase Service Account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Individual Environment Variables (useful for cloud deployments like Vercel/Render)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"

# Brevo (formerly Sendinblue) Transactional Email Credentials
BREVO_API_KEY=xkeysib-your-brevo-api-key-here
BREVO_SENDER_EMAIL=agency@getxh.in
BREVO_SENDER_NAME=GETXH Security Team

# Rate Limiting Configuration
FORGOT_PASSWORD_LIMIT_MAX=5
VERIFY_OTP_LIMIT_MAX=10
RESET_PASSWORD_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=3600000
